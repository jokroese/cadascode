<file path="apps/api/Dockerfile">
# Build context: apps/api
FROM python:3.12-slim AS base

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy project files and install dependencies
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Copy app code (for image; overwritten by volume in dev)
COPY . .

# Non-root user for dev (avoids permission issues on mounted volumes)
RUN groupadd -g 1000 app && useradd -u 1000 -g app -m app
RUN chown -R app:app /app
USER app

EXPOSE 8000

# Sync on start when volume overwrites; then run uvicorn with reload
CMD ["sh", "-c", "uv sync --frozen && uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]
</file>

<file path="apps/web/Dockerfile">
# Build context: repo root (dockerfile: apps/web/Dockerfile)
FROM node:24-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

# Copy workspace root and web app for install
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web apps/web

# Install with frozen lockfile (reproducible)
RUN pnpm install --frozen-lockfile

# Non-root user for dev (avoids permission issues on mounted volumes)
RUN addgroup -g 1000 app && adduser -u 1000 -G app -D app
RUN chown -R app:app /app
USER app

EXPOSE 5173

# Install on start when volume overwrites files; then run dev
CMD ["sh", "-c", "pnpm install --frozen-lockfile && pnpm --filter web dev --host 0.0.0.0"]
</file>

