		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.2.3",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.18",
		"jsdom": "^28.0.0",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"monaco-editor": "0.55.1"
